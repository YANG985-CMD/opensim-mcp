<?xml version="1.0" encoding="UTF-8"?>
<OpenSimDocument Version="40000">
  <Model name="mcp_moco_slider">
    <credits>Original analytic fixture for OpenSim MCP: a 2 kg mass, no gravity, one coordinate actuator.</credits>
    <length_units>meters</length_units><force_units>N</force_units><gravity>0 0 0</gravity>
    <Ground name="ground"/>
    <BodySet name="bodyset"><objects><Body name="block">
      <mass>2</mass><mass_center>0 0 0</mass_center><inertia>1 1 1 0 0 0</inertia>
    </Body></objects><groups/></BodySet>
    <JointSet name="jointset"><objects><SliderJoint name="slider">
      <socket_parent_frame>/ground</socket_parent_frame><socket_child_frame>/bodyset/block</socket_child_frame>
      <coordinates><Coordinate name="slider_tx"><default_value>0</default_value><range>-2 2</range>
        <clamped>false</clamped><locked>false</locked></Coordinate></coordinates>
    </SliderJoint></objects><groups/></JointSet>
    <ForceSet name="forceset"><objects><CoordinateActuator name="actuator">
      <coordinate>slider_tx</coordinate><optimal_force>1</optimal_force><min_control>-50</min_control><max_control>50</max_control>
    </CoordinateActuator></objects><groups/></ForceSet>
  </Model>
</OpenSimDocument>
