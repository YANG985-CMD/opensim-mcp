<?xml version='1.0' encoding='utf-8'?>
<OpenSimDocument Version="40000">
	<Model name="mcp_muscle_slider">
		
		<Ground name="ground">
			
			<FrameGeometry name="frame_geometry">
				
				<socket_frame>..</socket_frame>
				
				<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
			</FrameGeometry>
		</Ground>
		
		<gravity>-10 0 0</gravity>
		
		<BodySet name="bodyset">
			<objects>
				<Body name="block">
					
					<FrameGeometry name="frame_geometry">
						
						<socket_frame>..</socket_frame>
						
						<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
					</FrameGeometry>
					
					<mass>2</mass>
					
					<mass_center>0 0 0</mass_center>
					
					<inertia>1 1 1 0 0 0</inertia>
				</Body>
			</objects>
			<groups />
		</BodySet>
		
		<JointSet name="jointset">
			<objects>
				<SliderJoint name="slider">
					
					<socket_parent_frame>ground_offset</socket_parent_frame>
					
					<socket_child_frame>block_offset</socket_child_frame>
					
					<coordinates>
						<Coordinate name="slider_tx">
							
							<range>-0.10000000000000001 0.10000000000000001</range>
						</Coordinate>
					</coordinates>
					
					<frames>
						<PhysicalOffsetFrame name="ground_offset">
							
							<FrameGeometry name="frame_geometry">
								
								<socket_frame>..</socket_frame>
								
								<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
							</FrameGeometry>
							
							<socket_parent>/ground</socket_parent>
							
							<translation>0 0 0</translation>
							
							<orientation>0 0 0</orientation>
						</PhysicalOffsetFrame>
						<PhysicalOffsetFrame name="block_offset">
							
							<FrameGeometry name="frame_geometry">
								
								<socket_frame>..</socket_frame>
								
								<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
							</FrameGeometry>
							
							<socket_parent>/bodyset/block</socket_parent>
							
							<translation>0 0 0</translation>
							
							<orientation>0 0 0</orientation>
						</PhysicalOffsetFrame>
					</frames>
				</SliderJoint>
			</objects>
			<groups />
		</JointSet>
		
		<ControllerSet name="controllerset">
			<objects />
			<groups />
		</ControllerSet>
		
		<ForceSet name="forceset">
			<objects>
				<Millard2012EquilibriumMuscle name="puller">
					
					<min_control>0.01</min_control>
					
					<max_control>1</max_control>
					
					<GeometryPath name="geometrypath">
						
						<PathPointSet>
							<objects>
								<PathPoint name="origin">
									
									<socket_parent_frame>/ground</socket_parent_frame>
									
									<location>1 0 0</location>
								</PathPoint>
								<PathPoint name="insertion">
									
									<socket_parent_frame>/bodyset/block</socket_parent_frame>
									
									<location>0 0 0</location>
								</PathPoint>
							</objects>
							<groups />
						</PathPointSet>
						
						<Appearance>
							
							<color>0.80000000000000004 0.10000000000000001 0.10000000000000001</color>
						</Appearance>
					</GeometryPath>
					
					<max_isometric_force>100</max_isometric_force>
					
					<optimal_fiber_length>0.59999999999999998</optimal_fiber_length>
					
					<tendon_slack_length>0.40000000000000002</tendon_slack_length>
					
					<pennation_angle_at_optimal>0</pennation_angle_at_optimal>
					
					<ignore_tendon_compliance>true</ignore_tendon_compliance>
					
					<ignore_activation_dynamics>true</ignore_activation_dynamics>
					
					<ActiveForceLengthCurve name="puller_ActiveForceLengthCurve">
						
						<minimum_value>0</minimum_value>
					</ActiveForceLengthCurve>
					
					<ForceVelocityCurve name="puller_ForceVelocityCurve">
						
						<concentric_slope_at_vmax>0</concentric_slope_at_vmax>
						
						<concentric_slope_near_vmax>0.25</concentric_slope_near_vmax>
						
						<isometric_slope>5</isometric_slope>
						
						<eccentric_slope_at_vmax>0</eccentric_slope_at_vmax>
						
						<eccentric_slope_near_vmax>0.14999999999999999</eccentric_slope_near_vmax>
						
						<max_eccentric_velocity_force_multiplier>1.3999999999999999</max_eccentric_velocity_force_multiplier>
					</ForceVelocityCurve>
					
					<FiberForceLengthCurve name="puller_FiberForceLengthCurve">
						
					</FiberForceLengthCurve>
					
					<TendonForceLengthCurve name="puller_TendonForceLengthCurve">
						
					</TendonForceLengthCurve>
				</Millard2012EquilibriumMuscle>
			</objects>
			<groups />
		</ForceSet>
	<MarkerSet name="markerset">
      <objects>
        <Marker name="M1"><socket_parent_frame>/bodyset/block</socket_parent_frame><location>0 0 0</location></Marker>
        <Marker name="M2"><socket_parent_frame>/bodyset/block</socket_parent_frame><location>0 0.1 0</location></Marker>
        <Marker name="M3"><socket_parent_frame>/bodyset/block</socket_parent_frame><location>0 0 0.1</location></Marker>
      </objects><groups />
    </MarkerSet>
  </Model>
</OpenSimDocument>